# Neon Postgres (from Vercel -> Storage -> Neon). Pooled URL:
DATABASE_URL="postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Unpooled/direct URL, used for migrations:
DIRECT_URL="postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Admin login
ADMIN_EMAIL="hassen@verse.ad"
ADMIN_PASSWORD="change-this-to-a-long-password"

# Random 32+ char string used to sign the admin session cookie
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Transactional email. Set ONE of the two.
# Gmail: the founder's address plus a 16-character App Password (Google Account
# > Security > 2-Step Verification > App passwords). Mail then leaves from that
# address and replies land in the same inbox.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Resend (alternative, needs a verified sending domain):
RESEND_API_KEY=
MAIL_FROM=
